{
  "name": "batch-relay-dapp",
  "version": "2.0.0",
  "description": "Gas optimized batch transaction relayer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "compile": "forge build",
    "test": "forge test -vv",
    "test:gas": "forge test -vv --gas-report",
    "deploy:sepolia": "forge script script/Deploy.s.sol:DeployScript --rpc-url $SEPOLIA_RPC_URL --private-key $DEPLOYER_PRIVATE_KEY --broadcast --verify && node script/post-deploy.js",
    "deploy:local": "forge script script/Deploy.s.sol:DeployScript --rpc-url http://127.0.0.1:8545 --private-key $DEPLOYER_PRIVATE_KEY --broadcast && node script/post-deploy.js",
    "post-deploy": "node script/post-deploy.js"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "ethers": "^6.7.1",
    "express": "^4.18.2"
  }
}
